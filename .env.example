# Copy to .env and adjust. .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The development database. Created by `pnpm db:reset`.
DATABASE_URL=postgresql://postgres:atarimae_dev@localhost:5432/atarimae_dev

# The database used by integration tests and Playwright. Wiped freely.
TEST_DATABASE_URL=postgresql://postgres:atarimae_dev@localhost:5432/atarimae_test

# Connects to the maintenance database to CREATE/DROP the two above.
# Only used by scripts/db-reset.mjs, never by the running server.
ADMIN_DATABASE_URL=postgresql://postgres:atarimae_dev@localhost:5432/postgres

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Master key for the secret store (SMTP passwords, call provider secrets).
# 32 bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# WARNING: losing this key makes every stored external credential permanently
# unrecoverable. Back it up together with, but NOT inside, the database dump.
ENCRYPTION_KEY_CURRENT=key01:REPLACE_ME_WITH_32_BYTES_BASE64

# Set during key rotation so ciphertext written with the old key still decrypts.
# Leave empty when not rotating.
ENCRYPTION_KEY_PREVIOUS=

# Signs session cookies. 32+ random bytes, base64.
SESSION_SECRET=REPLACE_ME_WITH_32_BYTES_BASE64

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Public origin of the web client, used for CORS and links in emails.
PUBLIC_ORIGIN=http://localhost:5173

# trace | debug | info | warn | error
LOG_LEVEL=debug
