node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Secrets and local configuration. Never commit these.
.env
.env.*
!.env.example

# Playwright
playwright-report/
test-results/
e2e/.auth/
blob-report/

# Generated API client artifacts.
# apps/server/openapi.json is intentionally committed: it is the API contract,
# and CI fails when it drifts from the route schemas.
packages/api-schema/generated/

# Local Claude Code settings (per-machine, not shared).
# launch.json holds absolute paths to this machine's toolchain, including the
# Windows username — it must not reach a public repository.
.claude/settings.local.json
.claude/launch.json

# Editors and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
Thumbs.db
Desktop.ini
*.log
npm-debug.log*
pnpm-debug.log*

# Local attachment storage during development
var/
uploads/

# Where docker-compose bind-mounts `pnpm backup` output. An archive holds a
# full database dump — password hashes, every message, every attachment — so
# this is one directory that must never be committed by accident.
backups/

# Rust build output for the desktop client. Cargo.lock IS committed — it is a
# binary crate, and a reproducible build is the point.
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/schemas/
