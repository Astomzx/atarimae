# Normalize all text files to LF in the repository.
# Shell scripts must stay LF or they break inside Linux containers.
* text=auto eol=lf

*.sh    text eol=lf
*.bash  text eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf  binary
*.zip  binary
*.exe  binary

# Generated files: collapse in diffs and exclude from language stats.
pnpm-lock.yaml linguist-generated=true -diff
